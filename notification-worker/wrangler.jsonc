{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subscription-notifications",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "NOTIFICATION_DEVICES", "class_name": "NotificationDevice" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NotificationDevice"] }
  ]
}
